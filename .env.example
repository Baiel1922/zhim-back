# Copy to .env and fill in: `cp .env.example .env`.
# Values here target tools running on the host; docker-compose.dev.yml overrides
# hostnames (postgres, minio) for containers. Never commit .env.
# Secrets: generate with `openssl rand -hex 32`.
# "(step N)" marks variables that are read starting from that step of PROMPTS.md.

# ---------- General ----------
APP_ENV=development
LOG_LEVEL=debug
# Business timezone for reports (step 4)
APP_TIMEZONE=Asia/Bishkek

# ---------- Host ports published by `make dev` ----------
API_PORT=8090
WEB_PORT=3000
ADMIN_PORT=5173
IMGPROXY_PORT=8081
POSTGRES_PORT=5432
MINIO_PORT=9000
MINIO_CONSOLE_PORT=9001

# ---------- Public URLs (as seen from the browser) ----------
PUBLIC_API_URL=http://localhost:8090
WEB_URL=http://localhost:3000
ADMIN_URL=http://localhost:5173
IMGPROXY_URL=http://localhost:8081

# ---------- Backend HTTP ----------
HTTP_ADDR=:8090
# Comma-separated storefront and admin origins allowed to call the API from browsers
CORS_ALLOWED_ORIGINS=http://localhost:3000,http://localhost:5173
# Comma-separated CIDRs of reverse proxies whose X-Forwarded-For is trusted
# (prod: the Caddy network). Empty = the TCP peer is the client IP.
HTTP_TRUSTED_PROXY_CIDRS=
# Per-IP limits in requests per minute (0 = off): order creation + promo checks, order lookups
RATE_LIMIT_CHECKOUT_PER_MINUTE=10
RATE_LIMIT_LOOKUP_PER_MINUTE=60

# ---------- PostgreSQL ----------
POSTGRES_DB=zhim
POSTGRES_USER=zhim
POSTGRES_PASSWORD=change-me
# Keep in sync with the values above (step 1)
DATABASE_URL=postgres://zhim:change-me@localhost:5432/zhim?sslmode=disable

# ---------- S3 / MinIO ----------
S3_ENDPOINT=http://localhost:9000
S3_REGION=us-east-1
S3_BUCKET=zhim
# MinIO root credentials in dev; min 3 / 8 characters
S3_ACCESS_KEY=zhim
S3_SECRET_KEY=change-me-please

# ---------- imgproxy (hex-encoded) ----------
IMGPROXY_KEY=
IMGPROXY_SALT=

# ---------- Admin auth ----------
JWT_SECRET=
JWT_TTL=12h

# ---------- Storefront on-demand revalidation ----------
# Storefront URL as seen from the API (compose sets http://web:3000); empty disables revalidation
WEB_INTERNAL_URL=http://localhost:3000
REVALIDATE_SECRET=

# ---------- Telegram bot (admin sign-in, order notifications) ----------
TELEGRAM_BOT_TOKEN=
# Only one process may long-poll the bot; set false for extra local instances
TELEGRAM_BOT_ENABLED=true
# Daily summary to owners (HH:MM in APP_TIMEZONE)
TELEGRAM_DAILY_REPORT_TIME=21:00

# ---------- Seed (step 1): first owner admin ----------
SEED_OWNER_TELEGRAM_ID=
SEED_OWNER_NAME=Owner

# ---------- Analytics and ads (step 9); empty = disabled ----------
META_PIXEL_ID=
META_CAPI_ACCESS_TOKEN=
META_TEST_EVENT_CODE=
TIKTOK_PIXEL_ID=
TIKTOK_EVENTS_ACCESS_TOKEN=
TIKTOK_TEST_EVENT_CODE=
GA4_MEASUREMENT_ID=

# ---------- Backups (step 10) ----------
BACKUP_S3_BUCKET=zhim-backups
BACKUP_RETENTION_DAYS=14
